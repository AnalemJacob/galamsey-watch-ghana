rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /volunteerSubmissions/{submissionId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.resource.data.keys().hasAll(['owner', 'community', 'imagery', 'geometry', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['owner', 'community', 'imagery', 'geometry', 'status', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.community is string
        && request.resource.data.community.size() > 0
        && request.resource.data.community.size() <= 100
        && request.resource.data.imagery in [
          'sentinel', 'mapbox', '5ae4afd70b093000130affb1', '61f19914bc4fd60005518135',
          '6865bb4f1940c24e1ef7cfe2', '6868d0c9042b629ed848f09f', '5c88ffef225fc20007ab4e28',
          '5c87e19dc595d10005c1e8f8', '5bb108507e1a410005fd2ebb'
        ]
        && request.resource.data.geometry is string
        && request.resource.data.geometry.size() > 40
        && request.resource.data.geometry.size() <= 16000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }
  }
}
